FROM python:3.14-slim

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app

RUN pip install boto3==1.43.* botocore==1.43.* python-dotenv==1.2.* pyarrow==25.* httpx==0.28.*

WORKDIR /app
COPY backend/ backend/

ENV STORE_S3_ENDPOINT=

CMD ["python", "-m", "backend.pipeline.cleaning.daily", "--max-run-hours", "2"]
