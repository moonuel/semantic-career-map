FROM python:3.14-slim

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app

# Titan V2 encodes through Bedrock (no local model), so the torch /
# sentence-transformers stack is intentionally absent — those imports are
# lazy in backend/pipeline/embedding/encoder.py and only fire for a MiniLM
# rollback, which redeploys an old :embed image instead of rebuilding here.
# httpx is pinned explicitly: the embed path imports it transitively via the
# cleaning driver (llm_client), so it must not lean on a heavier package
# pulling it in.
RUN pip install boto3==1.43.* botocore==1.43.* python-dotenv==1.2.* \
      httpx==0.28.* numpy==2.5.* pyarrow==25.*

WORKDIR /app
COPY backend/ backend/
COPY scripts/embed.py scripts/embed.py
# The pinned production generation (its own configuration_hash): the same
# parameters the scheduler's day-2 no-op proof runs against. The 3.7
# validation baked the 100-row sample (deploy/embedding-config-sample.json,
# kept for the record); production operation embeds the full bound.
COPY deploy/embedding-config.json embedding-config.json

ENV STORE_S3_ENDPOINT=

CMD ["python", "scripts/embed.py", "--config-file", "/app/embedding-config.json"]
